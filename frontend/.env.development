# Loaded automatically by `next dev`. Production builds (`next build`) ignore it.
# When set, utils/api.ts skips network calls and uses an in-memory store seeded
# with sample alarms — see utils/mockApi.ts. Override locally by creating a
# .env.local file with `NEXT_PUBLIC_USE_MOCK_API=false` to test against the
# real Pi backend.
NEXT_PUBLIC_USE_MOCK_API=true
